{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/api/portfolios/:id", "destination": "/api/portfolios?id=:id" },
    { "source": "/api/clients/:id", "destination": "/api/clients?id=:id" },
    { "source": "/api/meta-accounts/:id", "destination": "/api/meta-accounts?id=:id" },
    { "source": "/api/scheduled-posts/:id", "destination": "/api/scheduled-posts?id=:id" },
    { "source": "/api/auth/youtube/:action", "destination": "/api/auth/youtube/[action]?action=:action" },

    { "source": "/api/ig-queue/:jobId", "destination": "/api/store?resource=ig-queue&jobId=:jobId" },
    { "source": "/api/ig-queue", "destination": "/api/store?resource=ig-queue" },
    { "source": "/api/config", "destination": "/api/store?resource=config" },
    { "source": "/api/omni-clients", "destination": "/api/store?resource=omni-clients" },
    { "source": "/api/chatgpt-clients", "destination": "/api/store?resource=chatgpt-clients" },

    { "source": "/api/meta-token-upgrade", "destination": "/api/migrate?action=meta-token-upgrade" },

    { "source": "/api/calendar/generate", "destination": "/api/calendar?action=generate" },
    { "source": "/api/calendar/:id", "destination": "/api/calendar?id=:id" }
  ],
  "crons": [
    {
      "path": "/api/cron/drive-bot",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/publish-all",
      "schedule": "0/30 * * * *"
    }
  ]
}
